
#include <stdio.h>

int main(void) {
    int x;

    // Repete o pedido enquanto o valor introduzido não estiver entre 0 e 1023
    do {
        printf("Entrada (valor entre 0 e 1023):\n");
        scanf("%d", &x);
    } while (x < 0 || x > 1023);

    // Calcula a temperatura em vírgula flutuante
    double temp = (260.0 * x) / 1023.0 - 20.0;

    // Apresenta o resultado formatado com 2 casas decimais
    printf("\nSaída:\n%.2f\n", temp);

    return 0;
}
